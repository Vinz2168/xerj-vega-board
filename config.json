{
  "$comment": "Main extension point. Pages and widget manifests load in this order. Page titles may be a string or { en, it }. connection: engine = xerj (API token) or elasticsearch/opensearch (username and password); urlEditable: false fixes the URL; showUrl: false hides it (and fixes it); revealPassword: false removes the eye on password/token; demo: false hides the demo data; engineSelectable: true shows the XERJ flag in the login (engine = its default). skin: classic (top bar) or nova (sidebar), the default style with XERJ and the demo (the user can switch it); Elasticsearch/OpenSearch always get the classic board. pages[].engines (optional): which connections show the page — xerj, demo, es. patternIndex / widgetIndex: where XERJ keeps the index patterns and the declarative (JSON) widgets. See AGENTS.md.",
  "connection": { "engine": "xerj", "engineSelectable": false, "url": "http://localhost:8080/es", "urlEditable": true, "showUrl": true, "revealPassword": true, "demo": true },
  "skin": "nova",
  "dashboardIndex": "vega-dashboards",
  "patternIndex": "vega-index-patterns",
  "widgetIndex": "vega-widgets",
  "pages": [
    { "id": "search", "title": { "en": "Search", "it": "Ricerca" }, "module": "pages/search/index.js", "css": "pages/search/search.css", "engines": ["xerj", "demo"] },
    { "id": "corpus", "title": { "en": "Corpus Hub", "it": "Corpus Hub" }, "module": "pages/corpus/index.js", "css": "pages/corpus/corpus.css", "engines": ["xerj"] },
    { "id": "memory", "title": { "en": "Agent Memory", "it": "Memoria agenti" }, "module": "pages/memory/index.js", "css": "pages/memory/memory.css", "engines": ["xerj", "demo"] },
    { "id": "dashboard", "title": { "en": "Dashboard", "it": "Dashboard" }, "module": "pages/dashboard/index.js", "css": "pages/dashboard/dashboard.css" },
    { "id": "discover", "title": { "en": "Discover", "it": "Discover" }, "module": "pages/discover/index.js", "css": "pages/discover/discover.css" },
    { "id": "devtools", "title": { "en": "Dev Tools", "it": "Dev Tools" }, "module": "pages/devtools/index.js", "css": "pages/devtools/devtools.css" },
    { "id": "indices", "title": { "en": "Indices", "it": "Indici" }, "module": "pages/indices/index.js", "css": "pages/indices/indices.css", "engines": ["xerj", "demo"] },
    { "id": "metrics", "title": { "en": "Metrics", "it": "Metriche" }, "module": "pages/metrics/index.js", "css": "pages/metrics/metrics.css", "engines": ["xerj", "demo"] },
    { "id": "settings", "title": { "en": "Settings", "it": "Impostazioni" }, "module": "pages/settings/index.js", "css": "pages/settings/settings.css", "engines": ["xerj", "demo"] }
  ],
  "widgets": [
    "widgets/dist/index.json",
    "widgets/custom/index.json"
  ]
}
